// Copy to Local.xcconfig. That file is gitignored. Do not commit it.
// Replace every placeholder. Do not paste a private key, certificate, or password.
//
// DEVELOPMENT_TEAM is the 10-character Team ID from your own Apple Developer
// account. PRODUCT_BUNDLE_IDENTIFIER must be a new macOS App ID you create.
// It must not be the bundle id of the existing iOS or watch target.
//
// CODE_SIGN_ENTITLEMENTS points at a copy of Push.entitlements.example
// named Push.entitlements, also gitignored, after you enable Push for that
// new App ID. Leave the line commented until that profile exists.

CODE_SIGNING_ALLOWED = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGNING_REQUIRED = YES
DEVELOPMENT_TEAM = YOUR_TEAM_ID
PRODUCT_BUNDLE_IDENTIFIER = REPLACE_WITH_YOUR_MAC_BUNDLE_ID
// CODE_SIGN_ENTITLEMENTS = Signing/Push.entitlements
